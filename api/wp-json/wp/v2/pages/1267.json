{"id":1267,"date":"2026-06-16T15:58:00","date_gmt":"2026-06-16T14:58:00","guid":{"rendered":"https:\/\/project-skyscraper.com\/?page_id=1267"},"modified":"2026-06-16T15:58:47","modified_gmt":"2026-06-16T14:58:47","slug":"report-ott-time-disruption","status":"publish","type":"page","link":"https:\/\/project-skyscraper.com\/report-ott-time-disruption\/","title":{"rendered":"Report: OTTAWA"},"content":{"rendered":"\n<div style=\"position: relative; width: 100%; max-width: 900px; margin: 40px auto; overflow: hidden; border-radius: 6px;\">\n  <canvas id=\"realitiesCanvas\" style=\"width: 100%; height: auto; display: block;\"><\/canvas>\n<\/div>\n\n<script>\n\/\/ ==================== MULTIPLE REALITIES ====================\nconst canvas = document.getElementById('realitiesCanvas');\nconst ctx = canvas.getContext('2d', { alpha: true });\n\nlet img = new Image();\nimg.src = \"https:\/\/iili.io\/CocgynS.jpg\";\n\nlet time = 0;\n\nimg.onload = () => {\n  canvas.width = img.width;\n  canvas.height = img.height;\n  animate();\n};\n\nfunction animate() {\n  time += 0.008;   \/\/\n\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n  \/\/ Past\n  ctx.globalAlpha = 0.76;\n  ctx.drawImage(img, Math.sin(time * 0.4) * 6, Math.cos(time * 0.5) * 4);\n\n  \/\/ Present\n  ctx.globalAlpha = 0.29;\n  ctx.filter = 'hue-rotate(335deg) contrast(1.5)';\n  ctx.drawImage(img, \n    Math.sin(time * 1.1) * 24, \n    Math.cos(time * 0.9) * 16\n  );\n\n  \/\/ Future\n  ctx.globalAlpha = 0.27;\n  ctx.filter = 'hue-rotate(175deg) blur(2px) contrast(1.4)';\n  ctx.drawImage(img, \n    Math.cos(time * 1.3) * -26, \n    Math.sin(time * 0.8) * 18\n  );\n\n  \/\/ Ghost\n  ctx.globalAlpha = 0.19;\n  ctx.filter = 'grayscale(0.8) brightness(1.18)';\n  ctx.drawImage(img, \n    Math.sin(time * 0.7) * 14, \n    Math.cos(time * 1.5) * -12\n  );\n\n  ctx.globalAlpha = 1;\n  ctx.filter = 'none';\n\n  ctx.fillStyle = \"rgba(18, 22, 48, 0.07)\";\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n  requestAnimationFrame(animate);\n}\n<\/script>\n","protected":false},"excerpt":{"rendered":"","protected":false},"author":279180095,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"advanced_seo_description":"","jetpack_seo_html_title":"","jetpack_seo_noindex":false,"footnotes":""},"class_list":["post-1267","page","type-page","status-publish","hentry"],"jetpack_likes_enabled":true,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/PhdnFZ-kr","jetpack-related-posts":[{"id":1273,"url":"https:\/\/project-skyscraper.com\/report-par-temporal-merge\/","url_meta":{"origin":1267,"position":0},"title":"Report: PARIS","author":"The Architect","date":"11 June 2026","format":false,"excerpt":"","rel":"","context":"Similar post","block_context":{"text":"Similar post","link":""},"img":{"alt_text":"","src":"","width":0,"height":0},"classes":[]},{"id":1223,"url":"https:\/\/project-skyscraper.com\/report-lon-reality-glitch\/","url_meta":{"origin":1267,"position":1},"title":"Report: LONDON","author":"The Architect","date":"1 June 2026","format":false,"excerpt":"","rel":"","context":"Similar post","block_context":{"text":"Similar post","link":""},"img":{"alt_text":"","src":"","width":0,"height":0},"classes":[]},{"id":75,"url":"https:\/\/project-skyscraper.com\/sleep-mode\/","url_meta":{"origin":1267,"position":2},"title":"SLEEP MODE","author":"The Architect","date":"25 April 2026","format":false,"excerpt":"status=nominal \u2588","rel":"","context":"Similar post","block_context":{"text":"Similar post","link":""},"img":{"alt_text":"","src":"","width":0,"height":0},"classes":[]},{"id":288,"url":"https:\/\/project-skyscraper.com\/sec-log-094316-full\/","url_meta":{"origin":1267,"position":3},"title":"Security Log","author":"The Architect","date":"30 May 2026","format":false,"excerpt":"[30\/5\/2026 09:43:16 AM] Event ID 5156 - System Diagnostic Protocol Application Information: Process ID: 16 Application Name: System 